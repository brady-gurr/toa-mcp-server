# Your TOA installer API token (bearer token). Get/rotate it from your TOA admin.
TOA_API_TOKEN=

# A long random secret YOU make up — this is what Claude's connector presents
# back to this server (separate from the TOA token, which never leaves this server).
# Generate one with: openssl rand -hex 32
MCP_SHARED_SECRET=

# Optional overrides
# TOA_BASE_URL=https://app.toa.energy/api/x
# PORT=3000
